# In production on Vercel, set this environment variable to your deployed backend URL:
# Example: https://inkloom-backend.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Clerk Authentication (Fast Signup & Multi-Role Governance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
