# Application Settings
PROJECT_NAME="Inkloom AI - Brand Governance Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# PostgreSQL + pgvector on Port 5433 (Async + Sync URLs for Alembic)
DATABASE_URL="postgresql+asyncpg://inkloom:inkloom_password@localhost:5433/inkloom_db"
SYNC_DATABASE_URL="postgresql+psycopg2://inkloom:inkloom_password@localhost:5433/inkloom_db"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"

# 100% FREE AI API KEYS
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=grok_ai_key

# Optional Free Fallback for ultra-fast inline typing checks (https://console.groq.com/keys)
GROQ_API_KEY=gemini_api_key

# Free Model Routing (All powered by Gemini Free Tier)
PRIMARY_LLM_MODEL="gemini-3.8-flash"
VISION_MODEL="gemini-25-flash"
FAST_INLINE_MODEL="llama-3.3-70b-versatile"
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS=768

# Governance & Accessibility Thresholds
DEFAULT_MIN_WCAG_CONTRAST=4.5
AMBIGUITY_OVERRIDE_THRESHOLD=0.40
UPLOAD_DIR="uploads"