# Application Settings
PROJECT_NAME="Inkloom AI - Brand Governance Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# PostgreSQL + pgvector on Port 5433 (Async + Sync URLs for Alembic)
DATABASE_URL="postgresql+asyncpg://inkloom:inkloom_password@localhost:5433/inkloom_db"
SYNC_DATABASE_URL="postgresql+psycopg2://inkloom:inkloom_password@localhost:5433/inkloom_db"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"

# 100% FREE AI API KEYS
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Groq key (leave blank)
GROQ_API_KEY=

PRIMARY_LLM_MODEL="gemini-3.5-flash"
VISION_MODEL="gemini-3.5-flash"
EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_DIMENSIONS=768

# Governance & Accessibility Thresholds
DEFAULT_MIN_WCAG_CONTRAST=4.5
AMBIGUITY_OVERRIDE_THRESHOLD=0.40
UPLOAD_DIR="uploads"

# Optional media storage. Leave all three blank to use backend/uploads locally.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="inkloom/submissions"
MEDIA_PUBLIC_BASE_URL="http://127.0.0.1:8000"

# Authentication & Security
JWT_SECRET="inkloom-brand-governance-jwt-secret-key-2026"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_DEMO_MODE=true
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Clerk Authentication (Fast Signup & Multi-Role Governance)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
